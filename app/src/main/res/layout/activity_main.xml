<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvEcran"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="48sp"
        android:gravity="end"
        android:padding="16dp"
        android:background="#212121"
        android:textColor="#FFFFFF"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5">

        <Button android:id="@+id/btn7" android:text="7" android:layout_columnWeight="1" android:textSize="24sp"/>
        <Button android:id="@+id/btn8" android:text="8" android:layout_columnWeight="1" android:textSize="24sp"/>
        <Button android:id="@+id/btn9" android:text="9" android:layout_columnWeight="1" android:textSize="24sp"/>
        <Button android:id="@+id/btnDiviser" android:text="÷" android:layout_columnWeight="1" android:textSize="24sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"/>

        <Button android:id="@+id/btn4" android:text="4" android:layout_columnWeight="1" android:textSize="24sp"/>
        <Button android:id="@+id/btn5" android:text="5" android:layout_columnWeight="1" android:textSize="24sp"/>
        <Button android:id="@+id/btn6" android:text="6" android:layout_columnWeight="1" android:textSize="24sp"/>
        <Button android:id="@+id/btnMultiplier" android:text="×" android:layout_columnWeight="1" android:textSize="24sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"/>

        <Button android:id="@+id/btn1" android:text="1" android:layout_columnWeight="1" android:textSize="24sp"/>
        <Button android:id="@+id/btn2" android:text="2" android:layout_columnWeight="1" android:textSize="24sp"/>
        <Button android:id="@+id/btn3" android:text="3" android:layout_columnWeight="1" android:textSize="24sp"/>
        <Button android:id="@+id/btnSoustraire" android:text="-" android:layout_columnWeight="1" android:textSize="24sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"/>

        <Button android:id="@+id/btn0" android:text="0" android:layout_columnWeight="1" android:textSize="24sp"/>
        <Button android:id="@+id/btnC" android:text="C" android:layout_columnWeight="1" android:textSize="24sp" android:backgroundTint="#F44336" android:textColor="#FFFFFF"/>
        <Button android:id="@+id/btnEgal" android:text="=" android:layout_columnWeight="1" android:textSize="24sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"/>
        <Button android:id="@+id/btnAdditionner" android:text="+" android:layout_columnWeight="1" android:textSize="24sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"/>

    </GridLayout>

</LinearLayout>